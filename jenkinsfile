pipeline {
    agent any

    environment {
        NOMBRE_CONTENEDOR="TRANSFORMAPI"
    }

    stages {
        stage('Instalar dependencias') {
            steps {
                sh '''
                python -m venv .venv
                .venv/bin/pip install --upgrade pip
                .venv/bin/pip install -r requirements.txt
               '''
            }
        }
        stage('Test') {
            steps {
                dir('python'){
                    sh 'pwd'
                    sh 'ls -la'
                    sh 'ls -la test'
                    sh 'python -m unittest discover -s test -p "test_*.py" -v'
                }
            }
        }

        stage('Construir imagen') {
            steps {
                sh '''
                    echo "Construyendo imagen Docker..."
                    docker build -t ${NOMBRE_CONTENEDOR}:latest .
                '''
            }
        }

        stage('Desplegar') {
            steps {
                sh '''
                    echo "Deteniendo contenedor anterior si existe..."
                    docker stop ${NOMBRE_CONTENEDOR} || true

                    echo "Eliminando contenedor anterior si existe..."
                    docker rm ${NOMBRE_CONTENEDOR} || true

                    echo "Creando y ejecutando nuevo contenedor..."
                    docker run -d \
                        --name ${NOMBRE_CONTENEDOR} \
                        ${NOMBRE_CONTENEDOR}:latest

                    echo "Despliegue completado."
                '''
            }
        }
    }
}
